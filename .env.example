# Copy to .env before building a deploy: `cp .env.example .env`.
# The value below is a Google OAuth client id — a public value that ships
# verbatim in every built bundle; Google's protection is the origin
# allowlist plus user consent, not the id's secrecy. It is committed here
# (as an example file, since scanners and convention expect .env itself
# untracked) so a plain clone can still produce the flightledger.net
# deploy. Self-hosters connecting Google Drive sync want their own client
# id from the Google Cloud console instead — this one only authorizes
# flightledger.net origins. Machine-local overrides go in .env.local
# (gitignored), which wins over .env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1053115174594-r23nb9f0hngmfinjn4snf1s17j9b4o56.apps.googleusercontent.com
